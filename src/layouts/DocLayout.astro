---
// 저장소 문서(실험 결과 등)를 사이트 스타일로 렌더하는 얇은 레이아웃.
// content/posts 컬렉션이 아니라 src/pages의 .md가 layout으로 사용한다.
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={frontmatter.title}>
  <a class="back-link" href={base + '/'}>← 블로그 목록</a>
  <article>
    <slot />
  </article>
</Layout>
