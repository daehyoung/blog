---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  const tags = new Set<string>();
  for (const p of posts) for (const t of p.data.tags ?? []) tags.add(t);

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => (p.data.tags ?? []).includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;

const slugOf = (id: string) =>
  id
    .split('/')
    .map((seg) => seg.replace(/^\d{4}-\d{2}-\d{2}-/, ''))
    .join('/');
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagUrl = (t: string) => `${base}/tags/${t}`;
---

<Layout title={`#${tag} — 조대형의 기술 노트`} description={`'${tag}' 태그가 달린 글`}>
  <a class="back-link" href={base + '/tags'}>← 전체 태그</a>
  <section class="intro">
    <h1><span class="card-no">#</span>{tag}</h1>
    <p class="lead">{posts.length}개의 글</p>
  </section>

  <ul class="card-list">
    {
      posts.map((post) => (
        <li>
          <div class="card">
            <h3 class="card-title">
              {post.data.series_order != null && (
                <span class="card-no">{post.data.series_order}편</span>
              )}
              <a class="card-titlelink" href={`${base}/${slugOf(post.id)}`}>
                {post.data.title}
              </a>
            </h3>
            <div class="card-meta">
              <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
              {post.data.tags?.slice(0, 5).map((t) => (
                <a class="tag" href={tagUrl(t)}>#{t}</a>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Layout>
