---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const slugOf = (id: string) =>
  id
    .split('/')
    .map((seg) => seg.replace(/^\d{4}-\d{2}-\d{2}-/, ''))
    .join('/');
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/blog'
const tagUrl = (t: string) => `${base}/tags/${t}`;

const all = (await getCollection('posts')).filter((p) => !p.data.draft);

const standalone = all
  .filter((p) => !p.data.series)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const seriesMap = new Map<string, typeof all>();
for (const p of all.filter((p) => p.data.series)) {
  const key = p.data.series as string;
  if (!seriesMap.has(key)) seriesMap.set(key, []);
  seriesMap.get(key)!.push(p);
}
for (const arr of seriesMap.values()) {
  arr.sort((a, b) => (a.data.series_order ?? 0) - (b.data.series_order ?? 0));
}
const seriesList = [...seriesMap.entries()];
---

<Layout
  title="조대형의 기술 노트"
  description="LLM · AI 에이전트 · 온프레미스 시스템에 대한 기술 글"
>
  <section class="intro">
    <h1>조대형의 기술 노트</h1>
    <p class="lead">LLM · AI 에이전트 · 온프레미스 시스템에 대한 기술 글.</p>
  </section>

  {
    standalone.length > 0 && (
      <section class="post-section">
        <h2 class="section-title">글</h2>
        <ul class="card-list">
          {standalone.map((post) => (
            <li>
              <div class="card">
                <h3 class="card-title">
                  <a class="card-titlelink" href={`${base}/${slugOf(post.id)}`}>
                    {post.data.title}
                  </a>
                </h3>
                <div class="card-meta">
                  <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
                  {post.data.tags?.slice(0, 5).map((t) => (
                    <a class="tag" href={tagUrl(t)}>#{t}</a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    seriesList.map(([name, parts]) => (
      <section class="post-section">
        <h2 class="section-title">
          <span class="section-badge">시리즈</span>
          {name}
        </h2>
        <ul class="card-list">
          {parts.map((post) => (
            <li>
              <div class="card">
                <h3 class="card-title">
                  {post.data.series_order != null && (
                    <span class="card-no">{post.data.series_order}편</span>
                  )}
                  <a class="card-titlelink" href={`${base}/${slugOf(post.id)}`}>
                    {post.data.title}
                  </a>
                </h3>
                <div class="card-meta">
                  <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
                  {post.data.tags?.slice(0, 5).map((t) => (
                    <a class="tag" href={tagUrl(t)}>#{t}</a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
