---
import { getPublishedPosts } from '../lib/posts';
import Layout from '../layouts/Layout.astro';

const slugOf = (id: string) =>
  id
    .split('/')
    .map((seg) => seg.replace(/^\d{4}-\d{2}-\d{2}-/, ''))
    .join('/');
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/blog'
const tagUrl = (t: string) => `${base}/tags/${t}`;

const all = await getPublishedPosts();

const standalone = all
  .filter((p) => !p.data.series)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const seriesMap = new Map<string, typeof all>();
for (const p of all.filter((p) => p.data.series)) {
  const key = p.data.series as string;
  if (!seriesMap.has(key)) seriesMap.set(key, []);
  seriesMap.get(key)!.push(p);
}
for (const arr of seriesMap.values()) {
  arr.sort((a, b) => (a.data.series_order ?? 0) - (b.data.series_order ?? 0));
}

// 홈에는 시리즈당 '개요(들어가며)' 링크 하나만 노출한다.
// 편별 목록은 각 시리즈 개요 글이 인덱스 역할을 한다(홈 → 시리즈 홈 → 각 편).
const seriesList = [...seriesMap.entries()]
  .map(([name, parts]) => {
    // 개요 = series_order가 없는 글. 없으면 첫 편을 진입점으로 쓴다.
    const entry = parts.find((p) => p.data.series_order == null) ?? parts[0];
    const episodes = parts.filter((p) => p !== entry).length;
    const latest = parts.reduce(
      (max, p) => (p.data.date > max ? p.data.date : max),
      parts[0].data.date,
    );
    // "들어가며 — 무엇무엇" 에서 뒷부분만 훅으로 쓴다.
    const hook = entry.data.title.replace(/^들어가며\s*[—–-]\s*/, '');
    return { name, entry, episodes, latest, hook };
  })
  .sort((a, b) => b.latest.valueOf() - a.latest.valueOf());
---

<Layout
  title="조대형의 기술 노트"
  description="LLM · AI 에이전트 · 온프레미스 시스템에 대한 기술 글"
>
  <section class="intro">
    <h1>조대형의 기술 노트</h1>
    <p class="lead">LLM · AI 에이전트 · 온프레미스 시스템에 대한 기술 글.</p>
  </section>

  {
    standalone.length > 0 && (
      <section class="post-section">
        <h2 class="section-title">글</h2>
        <ul class="post-list">
          {standalone.map((post) => (
            <li class="post-item">
              <h3 class="post-item-title">
                <a href={`${base}/${slugOf(post.id)}`}>{post.data.title}</a>
              </h3>
              <div class="post-item-meta">
                <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
                {post.data.tags?.slice(0, 5).map((t) => (
                  <a class="tag" href={tagUrl(t)}>#{t}</a>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    seriesList.length > 0 && (
      <section class="post-section">
        <h2 class="section-title">
          <span class="section-badge">시리즈</span>
          연재
        </h2>
        <ul class="post-list">
          {seriesList.map((s) => (
            <li class="post-item">
              <h3 class="post-item-title">
                <span class="post-no">{s.name}</span>
                <a href={`${base}/${slugOf(s.entry.id)}`}>{s.hook}</a>
              </h3>
              {s.entry.data.description && (
                <p class="series-desc">{s.entry.data.description}</p>
              )}
              <div class="post-item-meta">
                <time datetime={s.latest.toISOString()}>{fmtDate(s.latest)}</time>
                <span class="series-count">{s.episodes}편</span>
                {s.entry.data.tags
                  ?.filter((t) => t !== '시리즈개요')
                  .slice(0, 4)
                  .map((t) => (
                    <a class="tag" href={tagUrl(t)}>#{t}</a>
                  ))}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<style>
  .series-desc {
    margin: 0.35rem 0 0.5rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 62ch;
  }
  .series-count {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
